<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ═══════════ 顶栏 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/header_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:ignore="SmallSp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/settings" />

        <TextView
            android:id="@+id/btnHelp"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:text="@string/help" />
    </LinearLayout>

    <!-- ═══════════ 缓存目录卡片 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_title" />

            <TextView
                android:id="@+id/badgeMode"
                style="@style/Badge"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/badge_saf"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSourcePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@string/source_empty"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvScanInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="识别到 24 个视频，共 8.3 GB"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPickSource"
                style="@style/PillButton.Primary"
                android:layout_width="wrap_content"
                android:text="@string/pick_source" />

            <TextView
                android:id="@+id/btnRescan"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/rescan"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnFast"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:text="@string/enable_fast"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════ 输出目录卡片 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/output_title" />

            <TextView
                android:id="@+id/tvOutputPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="13sp"
                tools:text="Movies/BiliMerge" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPickOutput"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/pick_output" />

        <TextView
            android:id="@+id/btnResetOutput"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/reset_output"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ═══════════ 操作栏 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnSelectAll"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:text="@string/select_all" />

        <TextView
            android:id="@+id/btnSelectNone"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/select_none" />

        <TextView
            android:id="@+id/tvSelection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="已选 24 / 24" />

        <TextView
            android:id="@+id/btnCancel"
            style="@style/PillButton.Danger"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnStart"
            style="@style/PillButton.Primary"
            android:layout_width="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/start_merge" />
    </LinearLayout>

    <!-- ═══════════ 总进度 ═══════════ -->
    <LinearLayout
        android:id="@+id/progressPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/progressOverall"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="1000"
            tools:progress="420" />

        <TextView
            android:id="@+id/tvOverall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="12 / 24 完成 · 成功 11 · 失败 1" />
    </LinearLayout>

    <!-- ═══════════ 列表 ═══════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="36dp"
            android:text="@string/empty_hint"
            android:textColor="@color/text_disabled"
            android:textSize="14sp" />
    </FrameLayout>

</LinearLayout>
